ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# === NineRouter (9Router local proxy) ===
ROUTER9_API_KEY=
ROUTER9_BASE_URL=http://localhost:20128/v1
ROUTER9_MODEL=cc/claude-haiku-4-5-20251001

# === Kie AI (kieai.erweima.ai) ===
# Lay API key tai: https://kie.ai/api-key
# Xem danh sach model tai: https://kie.ai/market
KIEAI_API_KEY=
KIEAI_BASE_URL=https://kieai.erweima.ai/api/v1

# === Embedding (thay doi can re-ingest toan bo corpus) ===
EMBEDDING_MODEL=BAAI/bge-m3
# EMBEDDING_MODEL=AITeamVN/Vietnamese_Embedding  # cu, cosine scores thap hon

# === LLM ===
LLM_MODEL=claude-opus-4-7
# ROUTER_MODEL=mistral:latest      # model nho hon cho routing (mac dinh = LLM_MODEL)
# RERANKER_MODEL=BAAI/bge-reranker-v2-m3  # dat "none" de tat cross-encoder

# === Vectorstore ===
VECTORSTORE_DIR=./data/vectorstore
COLLECTION_NAME=legal_docs

# === Chunking (thay doi can re-ingest toan bo corpus) ===
# CHUNK_SIZE=400      # mac dinh 400 (truoc la 800); nho hon = citation chinh xac hon
# CHUNK_OVERLAP=50    # mac dinh 50 (truoc la 100)

# === API server security ===
# Neu set, moi request /v1/* phai gui header: Authorization: Bearer <key>
# De trong = khong bat auth (chi nen dung khi chay localhost)
API_AUTH_KEY=
# Origin duoc phep goi API (phan tach bang dau phay). "*" = mo het (tat credentials)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:8501
